<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- ES_Kettle (boiler pot) -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>DBH for Medieval</li>
    </mods>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/ThingDef[defName="ES_Kettle"]/comps</xpath>
      <value>
        <li Class="DubsBadHygiene.CompProperties_Pipe">
          <mode>Sewage</mode>
        </li>
        <li Class="DubsBadHygiene.CompProperties_WaterTrader">
          <WaterPerTick>0.001</WaterPerTick>
        </li>
        <li Class="PipesForMO.CompProperties_PipeHotWaterStorageFill">
          <ticksPerCheck>60</ticksPerCheck>
          <maxPullPerCheck>30</maxPullPerCheck>
          <onlyWhenLow>true</onlyWhenLow>
          <respectRefillMode>true</respectRefillMode>
          <pushedWaterTemperature>25</pushedWaterTemperature>
        </li>
      </value>
    </match>
  </Operation>

</Patch>
